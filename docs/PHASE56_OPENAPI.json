  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Message"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryMessage"
            },
            "type": "array",
            "maxItems": 12,
            "title": "History"
          },
          "detail": {
            "type": "string",
            "enum": [
              "concise",
              "standard",
              "technical"
            ],
            "title": "Detail",
            "default": "standard"
          },
          "max_queries": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Max Queries",
            "default": 3
          },
          "evidence_limit": {
            "type": "integer",
            "maximum": 40.0,
            "minimum": 1.0,
            "title": "Evidence Limit",
            "default": 12
          },
          "max_output_tokens": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 256.0,
            "title": "Max Output Tokens",
            "default": 4000
          },
          "scientific_parameters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scientific Parameters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "scientific-chat-v1",
            "title": "Schema Version",
            "default": "scientific-chat-v1"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "message_id": {
            "type": "string",
            "title": "Message Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Citations"
          },
          "evidence_groups": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence Groups"
          },
          "additional_candidates": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Additional Candidates"
          },
          "retrieval": {
            "additionalProperties": true,
            "type": "object",
            "title": "Retrieval"
          },
          "comparison": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comparison"
          },
          "discovery_suggestions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Discovery Suggestions"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "provider_status": {
            "additionalProperties": true,
            "type": "object",
            "title": "Provider Status"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "snapshot_id": {
            "type": "string",
            "title": "Snapshot Id"
          },
          "generation_status": {
            "additionalProperties": true,
            "type": "object",
            "title": "Generation Status"
          },
          "verification_status": {
            "additionalProperties": true,
            "type": "object",
            "title": "Verification Status"
          },
          "answer_completeness": {
            "additionalProperties": true,
            "type": "object",
            "title": "Answer Completeness"
          },
          "coverage_summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Coverage Summary"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "message_id",
          "answer",
          "evidence_groups",
          "provider_status",
          "trace_id",
          "snapshot_id"
        ],
        "title": "ChatResponse"
      },
      "ComparisonRequest": {
        "properties": {
          "subjects": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 2,
            "title": "Subjects"
          },
          "dimensions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Dimensions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subjects"
        ],
        "title": "ComparisonRequest"
      },
      "EntityConstraintV2": {
        "properties": {
          "relation": {
            "type": "string",
            "title": "Relation"
          },
          "entity_id": {
            "type": "string",
            "title": "Entity Id"
          }
        },
        "type": "object",
        "required": [
          "relation",
          "entity_id"
        ],
        "title": "EntityConstraintV2"
      },
      "GenericValue": {
        "properties": {
          "reported_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reported Value"
          },
          "reported_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reported Unit"
          },
          "canonical_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Value"
          },
          "canonical_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Unit"
          },
          "lower": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lower"
          },
          "upper": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper"
          },
          "approximate": {
            "type": "boolean",
            "title": "Approximate",
            "default": false
          },
          "raw_expression": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Expression"
          },
          "tolerance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Tolerance"
          }
        },
        "type": "object",
        "title": "GenericValue",
        "description": "Reported and normalized value form, never a property-specific field."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "HistoryMessage"
      },
      "PropertyConstraintV2": {
        "properties": {
          "property_id": {
            "type": "string",
            "title": "Property Id"
          },
          "operator": {
            "type": "string",
            "enum": [
              "EQ",
              "NEQ",
              "LT",
              "LTE",
              "GT",
              "GTE",
              "BETWEEN",
              "APPROX",
              "IN"
            ],
            "title": "Operator"
          },
          "value": {
            "$ref": "#/components/schemas/GenericValue"
          },
          "qualifiers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Qualifiers",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "property_id",
          "operator",
          "value"
        ],
        "title": "PropertyConstraintV2"
      },
      "ScenarioInput": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "scientific-scenario-v1",
            "title": "Schema Version",
            "default": "scientific-scenario-v1"
          },
          "scenario_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Scenario Id"
          },
          "question": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Question"
          },
          "provenance": {
            "type": "string",
            "enum": [
              "team_simulator",
              "user_hypothesis"
            ],
            "title": "Provenance",
            "default": "user_hypothesis"
          },
          "entity_constraints": {
            "items": {
              "$ref": "#/components/schemas/EntityConstraintV2"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Entity Constraints"
          },
          "property_constraints": {
            "items": {
              "$ref": "#/components/schemas/PropertyConstraintV2"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Property Constraints"
          },
          "unresolved_conditions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Unresolved Conditions"
          },
          "simulator_results": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Simulator Results"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenario_id",
          "question"
        ],
        "title": "ScenarioInput"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Query"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 12
          },
          "offset": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Offset",
            "default": 0
          },
          "research": {
            "type": "boolean",
            "title": "Research",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
